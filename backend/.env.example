# Everything here is optional. With no .env at all, `npm start` runs TransitOps on a
# built-in PostgreSQL with demo data. Copy this file to .env to change that.

# Use your own PostgreSQL instead of the built-in one:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/transitops?schema=public"

# Always use the built-in database, even if DATABASE_URL is set:
# TRANSITOPS_DB=embedded

# Signing key for sessions. If unset, one is generated at each start.
# JWT_SECRET="a-long-random-string"

# One-click demo sign-in on the login page. On by default with the built-in database.
# DEMO_MODE=true

# PORT=5000
